# ──────────────────────────────────────────────────────────────
# glitched.sh — environment variables
# Copy to .env.local and fill in your values. Never commit .env.local
# ──────────────────────────────────────────────────────────────

# Anthropic (only needed when running the agent pipeline locally)
AGENTS_API_SECRET=thisissecret

# Cloudflare Turnstile (bot/DDoS protection on /api/analyze)
# Create a site at dash.cloudflare.com → Security → Turnstile
# Add localhost + your production domain to the site's allowed domains
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...   # public — safe for client
TURNSTILE_SECRET_KEY=0x4AAAAAAA...              # server only — never prefix with NEXT_PUBLIC_

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@glitched.sh
RESEND_AUDIENCE_ID=...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────
# API MODE — controls where the analysis pipeline runs
# ──────────────────────────────────────────────────────────────

# Option 1 (default): Call the local /api/analyze route.
#   Requires @glitched/agents installed (private package).
#   Leave AGENTS_API_URL and NEXT_PUBLIC_USE_MOCK unset.

# Option 2: Forward to an external private API service.
#   Set this to the base URL of the deployed private API.
# AGENTS_API_URL=https://api.glitched.sh

# Option 3: Use mock data (dev/testing — no API calls made).
#   The breathing screen still plays; mock result is returned.
# NEXT_PUBLIC_USE_MOCK=true
